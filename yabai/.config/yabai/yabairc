#!/usr/bin/env sh

# yabai config — vendored from john-json/dotfiles, adapted:
#   gaps matched to this repo's 8px rhythm, external_bar synced to the
#   30px floating sketchybar, legacy border keys removed (JankyBorders
#   handles the focus ring), window_gap 20 -> 8.

# General
yabai -m config mouse_follows_focus on
yabai -m config focus_follows_mouse off
yabai -m config window_placement second_child
yabai -m config window_topmost on
yabai -m config window_shadow on

# Padding (top clears the 30px floating bar + 4px offset)
yabai -m config top_padding 34
yabai -m config bottom_padding 8
yabai -m config left_padding 8
yabai -m config right_padding 8
yabai -m config window_gap 8

# Layout
yabai -m config layout bsp
yabai -m config auto_balance on
yabai -m config split_ratio 0.5

# Animation (requires the SIP scripting addition — silently ignored without it)
yabai -m config window_animation_duration 0.25
yabai -m config window_opacity_duration 0.25
yabai -m config window_opacity off
yabai -m config insert_feedback_color 0xff5c7e81

# External bar (pad managed windows below the floating sketchybar)
yabai -m config external_bar all:34:0

# Floating rules (optional)
# yabai -m rule --add app="System Settings" manage=off
# yabai -m rule --add app="Finder" manage=off
