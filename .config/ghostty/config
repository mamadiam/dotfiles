# Ghostty terminal — Catppuccin Mocha
# Docs: https://ghostty.org/docs/config

# Theme is built into Ghostty (no import needed)
theme = tokyonight

# Font: JetBrains Mono Nerd Font (installed via Brewfile)
font-family = JetBrainsMono Nerd Font
font-size = 14

# Breathing room + centered content
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# Slight transparency over the wallpaper, with real blur behind it
background-opacity = 0.95
background-blur-radius = 60

# Starfield GLSL (vendored from omerxx/dotfiles): parallax stars drifting
# behind the glass. Toggle by commenting/uncommenting this line.
custom-shader = ~/.config/ghostty/shaders/space.glsl

# No titlebar chrome — the theme IS the chrome
macos-titlebar-style = hidden
window-decoration = false

# Quake terminal: global cmd+shift+d drops a terminal from the top
# (works from ANY app, animated 0.3s)
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-animation-duration = 0.3
keybind = global:cmd+shift+d=toggle_quick_terminal

# Option acts as Alt (essential for tmux + shell keybindings)
macos-option-as-alt = true

# Hide the cursor while typing (omerxx adoption)
mouse-hide-while-typing = true

# shift+enter inserts a real newline — multi-line input for AI prompts
# (hasnarobert adoption; \x1b\r = escaped newline for shells and TUIs)
keybind = shift+enter=text:\x1b\r

# Selection copies to clipboard, like tmux
copy-on-select = clipboard

# No window decorations noise
window-save-state = always
