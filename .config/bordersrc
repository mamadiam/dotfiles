#!/bin/bash
# JankyBorders — focus ring around the active window
# tokyonight: the accent lives on the frame — tokyonight blue; inactive
# windows keep a visible black outline (flameberry pattern).

style=round
width=2.0
hidpi=on
order="a"

active_color=0xff7aa2f7
inactive_color=0xff000000  # visible black outline on unfocused windows
