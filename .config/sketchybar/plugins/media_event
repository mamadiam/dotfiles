#!/usr/bin/env bash
# media_event — polls Spotify's AppleScript dictionary and fires sketchybar's
# custom `spotify_media` event (native media_change is dead on macOS 27:
# the MediaRemote framework is gated, so Spotify is polled directly).
# Album art is fetched from iTunes Search and set on `media.artwork`.
# Launched by items/widgets/media.lua; single-instance via pidfile.

INTERVAL="${1:-2}"
ARTWORK_JPG="/tmp/sketchybar_media_art.jpg"
ARTWORK="$HOME/.cache/sketchybar/media_art.png"
PIDFILE="/tmp/sketchybar_media_event.pid"
mkdir -p "$(dirname "$ARTWORK")"

# Single instance: a stale pidfile (reboot) is fine — the pid is dead.
# If the holder is still alive it belongs to the previous bar generation and
# exits within one INTERVAL — wait it out instead of exiting immediately.
if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
  for _ in 1 2 3 4 5; do
    sleep 1
    kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null || break
  done
  kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null && exit 0
fi
echo $$ > "$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT

# Live as long as the BAR lives. (The launcher is the transient config script,
# not the long-lived sketchybar process — don't watch the parent.)
bar_alive() { pgrep -x sketchybar >/dev/null 2>&1; }

last=""
art_track=""

while bar_alive; do
  line=$(osascript -e 'tell application "Spotify" to (player state as text) & "|" & (name of current track) & "|" & (artist of current track)' 2>/dev/null)

  state="${line%%|*}"
  if [[ "$state" == "playing" || "$state" == "paused" ]]; then
    rest="${line#*|}"
    title="${rest%%|*}"
    artist="${rest#*|}"
  else
    state="idle"
    title=""
    artist=""
  fi

  sig="$state|$title|$artist"
  if [[ "$sig" != "$last" ]]; then
    last="$sig"
    esc_title=${title//\"/\\\\\"}
    esc_artist=${artist//\"/\\\\\"}
    sketchybar --trigger spotify_media "APP=Spotify" "TITLE=$esc_title" "ARTIST=$esc_artist" "STATE=$state"
  fi

  # Fetch cover art only when the track actually changes (needs network + jq).
  # sketchybar v2 fails to load JPEGs from disk — convert to PNG via sips.
  if [[ -n "$title" && "$title" != "$art_track" ]]; then
    art_track="$title"
    url=$(curl -sgG "https://itunes.apple.com/search" \
      --data-urlencode "term=${title} ${artist}" \
      --data-urlencode "entity=song" \
      --data-urlencode "limit=1" 2>/dev/null |
      jq -r '.results[0].artworkUrl100? // empty' 2>/dev/null |
      sed 's/100x100/400x400/')
    if [[ -n "$url" ]] && curl -s "$url" -o "$ARTWORK_JPG" &&
      sips -s format png "$ARTWORK_JPG" --out "$ARTWORK" >/dev/null 2>&1; then
      sketchybar --set media_cover background.image="$ARTWORK"
    fi
  fi

  sleep "$INTERVAL"
done
