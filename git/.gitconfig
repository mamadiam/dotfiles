# Managed by dotfiles — per-machine identity goes in ~/.gitconfig.local instead.
[user]
	name = YOUR NAME
	email = you@example.com

[init]
	defaultBranch = main

[core]
	autocrlf = input
	editor = nvim
	pager = delta
	excludesfile = ~/.gitignore_global

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default

[alias]
	st = "status -sb"
	co = "checkout"
	br = "branch"
	cm = "commit -m"
	undo = "reset --soft HEAD~1"
	last = "log -1 HEAD --stat"
	lg = "log --oneline --graph --decorate -20"

# --- Workflow hardening (best practices from reference repos) ---------------
[pull]
	ff = only

[push]
	autoSetupRemote = true

[rebase]
	autostash = true

[commit]
	template = ~/.gitmessage

# --- GitHub auth via gh CLI (no tokens in files) ------------------------------
[credential "https://github.com"]
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !/opt/homebrew/bin/gh auth git-credential

[include]
	path = ~/.gitconfig.local

# --- Work/personal split (pattern — enable by creating the file) --------------
# Real work identity lives OUTSIDE this repo, e.g. ~/.gitconfig_work:
#   [user]
#       name  = Your Work Name
#       email = you@company.com
# Then uncomment:
# [includeIf "gitdir:~/code/work/**/.git"]
# 	path = ~/.gitconfig_work
