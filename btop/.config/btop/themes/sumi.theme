# btop — sumi: paper and ink
# Bone ramp on black; every gradient climbs toward vermillion at full load.

theme[main_bg]="#000000"
theme[main_fg]="#cdc4ba"
theme[title_fg]="#cdc4ba"
theme[hi_fg]="#e2342a"
theme[hi_bg]="#1a1817"
theme[div_line]="#353330"
theme[selected_fg]="#000000"
theme[selected_bg]="#cdc4ba"
theme[proc_misc]="#958f87"

# cpu: ink → vermillion as load climbs
theme[cpu_start]="#7a756e"
theme[cpu_mid]="#b0a9a0"
theme[cpu_end]="#e2342a"

# memory free
theme[free_start]="#1a1817"
theme[free_mid]="#57534c"
theme[free_end]="#9daa84"

# memory available
theme[available_start]="#1a1817"
theme[available_mid]="#8a6f3a"
theme[available_end]="#d8a657"

# cached
theme[cached_start]="#1a1817"
theme[cached_mid]="#4e5a68"
theme[cached_end]="#7f9dbe"

# network
theme[net_start]="#1a1817"
theme[net_mid]="#5e7678"
theme[net_end]="#8fb5b8"

# processes
theme[proc_start]="#1a1817"
theme[proc_mid]="#8a7a89"
theme[proc_end]="#c39ac3"

theme[meter_bg]="#1a1817"
